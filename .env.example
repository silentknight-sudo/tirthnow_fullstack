# ---------------------------------------------------------------------------
# Tirth Now — environment variables
# Copy to .env. Defaults below run everything locally with mocks and
# docker-compose services. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PROCESS_ROLE=all                 # api | worker | all
API_PORT=4000
WORKER_PORT=4100
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
TRUST_PROXY=0                    # number of proxy hops in front of the API (1 behind a load balancer)
SWAGGER_ENABLED=                 # Swagger is always on outside production; set true to expose it in production
ALLOW_MOCK_PROVIDERS=            # prod only: comma list, e.g. whatsapp,transit

# --- Database / cache --------------------------------------------------------
DATABASE_URL=postgresql://tirthnow:tirthnow@localhost:5432/tirthnow?schema=public
DATABASE_URL_TEST=postgresql://tirthnow:tirthnow@localhost:5432/tirthnow_test?schema=public
SHADOW_DATABASE_URL=postgresql://tirthnow:tirthnow@localhost:5432/tirthnow_shadow?schema=public
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6379/15

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=tirth-now
DATA_ENCRYPTION_KEY=base64-32-byte-key-for-bank-account-encryption=

FIREBASE_AUTH_PROVIDER=mock      # mock | firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Rate limits -------------------------------------------------------------
THROTTLE_DEFAULT_PER_MIN=120
THROTTLE_AUTH_PER_MIN=10
SOS_MAX_PER_10_MIN=3

# --- Storage (MinIO locally, Cloudflare R2 in prod) --------------------------
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=tirthnow-public
S3_BUCKET_PRIVATE=tirthnow-private
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/tirthnow-public
UPLOAD_MAX_IMAGE_MB=15
UPLOAD_MAX_VIDEO_MB=200

# --- Video -------------------------------------------------------------------
VIDEO_PROVIDER=mock              # mock | cloudflare_stream | mux
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_WEBHOOK_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# --- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=mock            # mock | razorpay
MOCK_PAYMENT_SECRET=local-mock-payment-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=
ORDER_HOLD_MINUTES=15
PAYOUT_SETTLEMENT_HOLD_DAYS=3

# --- Messaging ---------------------------------------------------------------
SMS_PROVIDER=mock                # mock | msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_ENTITY_ID=

WHATSAPP_PROVIDER=mock           # mock | meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

PUSH_PROVIDER=mock               # mock | fcm

EMAIL_PROVIDER=smtp              # smtp (Mailpit locally) | mock (in-memory, see GET /v1/dev/outbox)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Tirth Now <no-reply@tirthnow.local>"

# --- Portals (used in emailed links) -----------------------------------------
VENDOR_PORTAL_URL=http://localhost:3001
ADMIN_PORTAL_URL=http://localhost:3002

# --- Seed (local only) ---------------------------------------------------------
SEED_ADMIN_PASSWORD=TirthNow@Admin123
SEED_VENDOR_PASSWORD=TirthNow@Vendor123

# --- Maps / weather / transit ------------------------------------------------
MAPS_PROVIDER=mock               # mock | google
GOOGLE_MAPS_API_KEY=
WEATHER_PROVIDER=mock            # mock | openweather
OPENWEATHER_API_KEY=
WEATHER_CACHE_SECONDS=900
TRANSIT_PROVIDER=mock

# --- AI ----------------------------------------------------------------------
LLM_PROVIDER=mock                # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_DEFAULT=
LLM_MODEL_CHEAP=
EMBEDDING_PROVIDER=mock          # mock | openai | voyage
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
VOYAGE_API_KEY=
AI_DAILY_QUOTA_GUEST=10
AI_DAILY_QUOTA_USER=50
AI_RESPONSE_CACHE_SECONDS=86400

STT_PROVIDER=mock                # mock | google
TTS_PROVIDER=mock                # mock | google
VISION_PROVIDER=mock             # mock | google
TRANSLATE_PROVIDER=mock          # mock | google
MODERATION_PROVIDER=mock         # mock | llm
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0

# --- Web portals (exposed to the browser — publishable values only) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
