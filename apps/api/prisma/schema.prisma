// ───────────────────────────── Identity ─────────────────────────────

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid  String?    @unique @map("firebase_uid")
  email        String?    @unique @db.Citext
  phoneE164    String?    @unique @map("phone_e164")
  passwordHash String?    @map("password_hash")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  isGuest      Boolean    @default(false) @map("is_guest")
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile           UserProfile?
  roles             UserRole[]
  devices           Device[]
  refreshTokens     RefreshToken[]
  emergencyContacts EmergencyContact[]
  mediaAssets       MediaAsset[]
  ownedVendors      Vendor[]            @relation("VendorOwner")
  approvedVendors   Vendor[]            @relation("VendorApprover")
  vendorStaff       VendorStaff[]
  kycReviews        VendorKycDocument[]
  drivenVehicles    Vehicle[]
  orders            Order[]
  refundsInitiated  Refund[]
  payoutsApproved   Payout[]
  reviews           Review[]
  reels             Reel[]
  reelLikes         ReelLike[]
  reelComments      ReelComment[]
  reelSaves         ReelSave[]
  following         Follow[]            @relation("Follower")
  followers         Follow[]            @relation("Followee")
  reports           Report[]
  moderationActions ModerationAction[]
  knowledgeUploaded KnowledgeDocument[] @relation("KdocUploader")
  knowledgeApproved KnowledgeDocument[] @relation("KdocApprover")
  chatSessions      ChatSession[]
  itineraries       Itinerary[]
  notifications     Notification[]
  sosEvents         SosEvent[]          @relation("SosUser")
  sosHandled        SosEvent[]          @relation("SosHandler")
  auditLogs         AuditLog[]
  configUpdates     AppConfig[]
  aiUsage           AiUsage[]
  idempotencyKeys   IdempotencyKey[]

  @@map("users")
}

model UserProfile {
  userId            String   @id @map("user_id") @db.Uuid
  displayName       String?  @map("display_name")
  avatarMediaId     String?  @map("avatar_media_id") @db.Uuid
  preferredLang     String   @default("en") @map("preferred_lang")
  homeCityId        String?  @map("home_city_id") @db.Uuid
  accessibility     Json     @default("{}")
  notificationPrefs Json     @default("{}") @map("notification_prefs")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar   MediaAsset? @relation(fields: [avatarMediaId], references: [id])
  homeCity City?       @relation(fields: [homeCityId], references: [id])

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         RoleKey  @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users UserRole[]

  @@map("roles")
}

/// vendor_id scopes vendor_owner / vendor_staff grants; NULL for global roles.
model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  vendorId  String?  @map("vendor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, vendorId])
  @@index([userId])
  @@map("user_roles")
}

model Device {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  fcmToken   String?        @unique @map("fcm_token")
  platform   DevicePlatform
  appVersion String?        @map("app_version")
  locale     String?
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmergencyContact {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String
  phoneE164      String   @map("phone_e164")
  relation       String?
  notifyWhatsapp Boolean  @default(true) @map("notify_whatsapp")
  priority       Int      @default(0) @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

// ───────────────────────────── Catalog & media ─────────────────────────────

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  nameI18n  Json     @map("name_i18n")
  lat       Float
  lng       Float
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  temples            Temple[]
  pois               Poi[]
  exploreItems       ExploreItem[]
  festivals          Festival[]
  profiles           UserProfile[]
  vendors            Vendor[]
  hotels             Hotel[]
  restaurants        Restaurant[]
  experiences        Experience[]
  commissionRules    CommissionRule[]
  reels              Reel[]
  knowledgeDocuments KnowledgeDocument[]
  chatSessions       ChatSession[]
  itineraryDays      ItineraryDay[]

  @@map("cities")
}

model Temple {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId          String    @map("city_id") @db.Uuid
  slug            String    @unique
  nameI18n        Json      @map("name_i18n")
  descriptionI18n Json?     @map("description_i18n")
  historyI18n     Json?     @map("history_i18n")
  lat             Float
  lng             Float
  address         String?
  openingHours    Json      @default("{}") @map("opening_hours")
  dressCodeI18n   Json?     @map("dress_code_i18n")
  tags            String[]  @default([])
  coverMediaId    String?   @map("cover_media_id") @db.Uuid
  galleryMediaIds String[]  @default([]) @map("gallery_media_ids") @db.Uuid
  crowdLevel      Int       @default(0) @map("crowd_level") @db.SmallInt
  isPublished     Boolean   @default(true) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  city           City                 @relation(fields: [cityId], references: [id])
  cover          MediaAsset?          @relation(fields: [coverMediaId], references: [id])
  aartiSchedules AartiSchedule[]
  festivals      Festival[]
  routeStops     ParikramaRouteStop[]
  reels          Reel[]
  knowledgeDocs  KnowledgeDocument[]
  itineraryItems ItineraryItem[]

  @@index([cityId])
  @@index([lat, lng])
  @@map("temples")
}

/// local_time is Asia/Kolkata wall-clock; expanded to UTC instants by the catalog service.
model AartiSchedule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templeId       String    @map("temple_id") @db.Uuid
  kind           AartiKind
  nameI18n       Json      @map("name_i18n")
  localTime      DateTime  @map("local_time") @db.Time(0)
  durationMin    Int       @default(15) @map("duration_min") @db.SmallInt
  recurrence     String    @default("FREQ=DAILY")
  validFrom      DateTime? @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  season         String    @default("all")
  isLiveStreamed Boolean   @default(false) @map("is_live_streamed")
  streamUrl      String?   @map("stream_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  temple         Temple          @relation(fields: [templeId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[]

  @@index([templeId, localTime])
  @@map("aarti_schedules")
}

model Festival {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId            String?  @map("city_id") @db.Uuid
  templeId          String?  @map("temple_id") @db.Uuid
  nameI18n          Json     @map("name_i18n")
  descriptionI18n   Json?    @map("description_i18n")
  startsOn          DateTime @map("starts_on") @db.Date
  endsOn            DateTime @map("ends_on") @db.Date
  crowdAdvisoryI18n Json?    @map("crowd_advisory_i18n")
  coverMediaId      String?  @map("cover_media_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city   City?       @relation(fields: [cityId], references: [id])
  temple Temple?     @relation(fields: [templeId], references: [id])
  cover  MediaAsset? @relation(fields: [coverMediaId], references: [id])

  @@index([startsOn, endsOn])
  @@map("festivals")
}

model Poi {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId      String      @map("city_id") @db.Uuid
  category    PoiCategory
  nameI18n    Json        @map("name_i18n")
  lat         Float
  lng         Float
  address     String?
  phoneE164   String?     @map("phone_e164")
  is24x7      Boolean     @default(false) @map("is_24x7")
  isEmergency Boolean     @default(false) @map("is_emergency")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)

  city           City                 @relation(fields: [cityId], references: [id])
  routeStops     ParikramaRouteStop[]
  itineraryItems ItineraryItem[]

  @@index([cityId, category])
  @@index([lat, lng])
  @@map("pois")
}

model ExploreItem {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId       String      @map("city_id") @db.Uuid
  kind         ExploreKind
  titleI18n    Json        @map("title_i18n")
  bodyI18n     Json?       @map("body_i18n")
  lat          Float?
  lng          Float?
  coverMediaId String?     @map("cover_media_id") @db.Uuid
  sortOrder    Int         @default(0) @map("sort_order")
  isPublished  Boolean     @default(true) @map("is_published")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  city           City            @relation(fields: [cityId], references: [id])
  cover          MediaAsset?     @relation(fields: [coverMediaId], references: [id])
  itineraryItems ItineraryItem[]

  @@index([cityId, kind])
  @@map("explore_items")
}

model ParikramaRoute {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  nameI18n        Json     @map("name_i18n")
  descriptionI18n Json?    @map("description_i18n")
  distanceM       Int      @map("distance_m")
  estDurationMin  Int      @map("est_duration_min")
  polyline        String?
  difficulty      String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stops ParikramaRouteStop[]

  @@map("parikrama_routes")
}

model ParikramaRouteStop {
  routeId  String  @map("route_id") @db.Uuid
  seq      Int     @db.SmallInt
  templeId String? @map("temple_id") @db.Uuid
  poiId    String? @map("poi_id") @db.Uuid
  noteI18n Json?   @map("note_i18n")

  route  ParikramaRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  temple Temple?        @relation(fields: [templeId], references: [id])
  poi    Poi?           @relation(fields: [poiId], references: [id])

  @@id([routeId, seq])
  @@map("parikrama_route_stops")
}

model MediaAsset {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String?     @map("owner_user_id") @db.Uuid
  kind        MediaKind
  storageKey  String      @unique @map("storage_key")
  mimeType    String      @map("mime_type")
  sizeBytes   Int?        @map("size_bytes")
  width       Int?
  height      Int?
  durationMs  Int?        @map("duration_ms")
  status      MediaStatus @default(pending_upload)
  variants    Json        @default("{}")
  blurhash    String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)

  owner              User?               @relation(fields: [ownerUserId], references: [id])
  avatarsFor         UserProfile[]
  templeCovers       Temple[]
  festivalCovers     Festival[]
  exploreCovers      ExploreItem[]
  kycDocuments       VendorKycDocument[]
  menuItems          MenuItem[]
  reelVideos         Reel[]              @relation("ReelVideo")
  reelThumbnails     Reel[]              @relation("ReelThumbnail")
  knowledgeDocuments KnowledgeDocument[]

  @@index([ownerUserId])
  @@map("media_assets")
}

// ───────────────────────────── Vendors ─────────────────────────────

model Vendor {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId             String       @map("owner_user_id") @db.Uuid
  type                    VendorType
  legalName               String       @map("legal_name")
  displayName             String       @map("display_name")
  gstin                   String?
  pan                     String?
  cityId                  String?      @map("city_id") @db.Uuid
  status                  VendorStatus @default(draft)
  razorpayLinkedAccountId String?      @unique @map("razorpay_linked_account_id")
  commissionRuleId        String?      @map("commission_rule_id") @db.Uuid
  approvedAt              DateTime?    @map("approved_at") @db.Timestamptz(3)
  approvedById            String?      @map("approved_by") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?    @map("deleted_at") @db.Timestamptz(3)

  owner          User                @relation("VendorOwner", fields: [ownerUserId], references: [id])
  approvedBy     User?               @relation("VendorApprover", fields: [approvedById], references: [id])
  city           City?               @relation(fields: [cityId], references: [id])
  commissionRule CommissionRule?     @relation("VendorCommissionOverride", fields: [commissionRuleId], references: [id])
  scopedRules    CommissionRule[]    @relation("VendorScopedRules")
  userRoles      UserRole[]
  kycDocuments   VendorKycDocument[]
  staff          VendorStaff[]
  bankAccounts   VendorBankAccount[]
  hotels         Hotel[]
  vehicles       Vehicle[]
  cabFares       CabFare[]
  restaurants    Restaurant[]
  experiences    Experience[]
  orders         Order[]
  ledgerEntries  LedgerEntry[]
  payouts        Payout[]

  @@index([ownerUserId])
  @@index([status])
  @@map("vendors")
}

model VendorKycDocument {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String     @map("vendor_id") @db.Uuid
  docType      KycDocType @map("doc_type")
  mediaId      String     @map("media_id") @db.Uuid
  status       KycStatus  @default(pending)
  reviewerNote String?    @map("reviewer_note")
  reviewedById String?    @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?  @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id])
  reviewedBy User?      @relation(fields: [reviewedById], references: [id])

  @@index([vendorId])
  @@map("vendor_kyc_documents")
}

model VendorStaff {
