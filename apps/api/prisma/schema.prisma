  temple    Temple?       @relation(fields: [templeId], references: [id])
  likes     ReelLike[]
  comments  ReelComment[]
  saves     ReelSave[]

  @@index([status, score(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([hashtags], type: Gin)
  @@map("reels")
}

model ReelLike {
  reelId    String   @map("reel_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reelId, userId])
  @@map("reel_likes")
}

model ReelComment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reelId           String           @map("reel_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  parentId         String?          @map("parent_id") @db.Uuid
  body             String
  moderationStatus ModerationStatus @default(pending) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)

  reel    Reel          @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  parent  ReelComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies ReelComment[] @relation("CommentThread")

  @@index([reelId, createdAt])
  @@map("reel_comments")
}

model ReelSave {
  reelId    String   @map("reel_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reelId, userId])
  @@map("reel_saves")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// reporter_id NULL = automatic flag raised by the AI moderation job.
model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String?      @map("reporter_id") @db.Uuid
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  reasonCode String       @map("reason_code")
  details    String?
  aiScores   Json?        @map("ai_scores")
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter User?              @relation(fields: [reporterId], references: [id])
  actions  ModerationAction[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model ModerationAction {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String?      @map("report_id") @db.Uuid
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  action     ModAction
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report? @relation(fields: [reportId], references: [id])
  actor  User?   @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@map("moderation_actions")
}

// ───────────────────────────── AI ─────────────────────────────

model KnowledgeDocument {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  sourceType   KnowledgeSource @map("source_type")
  sourceRef    String?         @map("source_ref")
  mediaId      String?         @map("media_id") @db.Uuid
  lang         String          @default("en")
  cityId       String?         @map("city_id") @db.Uuid
  templeId     String?         @map("temple_id") @db.Uuid
  status       KdocStatus      @default(draft)
  contentHash  String?         @map("content_hash")
  uploadedById String?         @map("uploaded_by") @db.Uuid
  approvedById String?         @map("approved_by") @db.Uuid
  indexedAt    DateTime?       @map("indexed_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  media      MediaAsset?      @relation(fields: [mediaId], references: [id])
  city       City?            @relation(fields: [cityId], references: [id])
  temple     Temple?          @relation(fields: [templeId], references: [id])
  uploadedBy User?            @relation("KdocUploader", fields: [uploadedById], references: [id])
  approvedBy User?            @relation("KdocApprover", fields: [approvedById], references: [id])
  chunks     KnowledgeChunk[]

  @@index([status])
  @@map("knowledge_documents")
}

/// embedding has an HNSW (vector_cosine_ops) index created in raw SQL (rx_knowledge_chunks_embedding_hnsw).
model KnowledgeChunk {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String                       @map("document_id") @db.Uuid
  chunkIndex     Int                          @map("chunk_index")
  content        String
  tokenCount     Int                          @map("token_count")
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")
  cityId         String?                      @map("city_id") @db.Uuid
  templeId       String?                      @map("temple_id") @db.Uuid
  lang           String                       @default("en")
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([cityId])
  @@index([templeId])
  @@map("knowledge_chunks")
}

model ChatSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String?
  lang          String    @default("en")
  cityId        String?   @map("city_id") @db.Uuid
  memorySummary String?   @map("memory_summary")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?         @relation(fields: [cityId], references: [id])
  messages ChatMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  role         ChatRole
  content      String
  citations    Json?
  toolCalls    Json?    @map("tool_calls")
  model        String?
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  latencyMs    Int?     @map("latency_ms")
  flagged      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model Itinerary {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  title        String
  startDate    DateTime        @map("start_date") @db.Date
  days         Int             @db.SmallInt
  budgetPaise  Int?            @map("budget_paise")
  partySize    Int             @default(1) @map("party_size") @db.SmallInt
  preferences  Json            @default("{}")
  shareToken   String?         @unique @map("share_token")
  status       ItineraryStatus @default(draft)
  model        String?
  rawLlmOutput Json?           @map("raw_llm_output")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id])
  dayList ItineraryDay[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("itineraries")
}

model ItineraryDay {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId String   @map("itinerary_id") @db.Uuid
  dayIndex    Int      @map("day_index") @db.SmallInt
  date        DateTime @db.Date
  cityId      String?  @map("city_id") @db.Uuid
  notesI18n   Json?    @map("notes_i18n")

  itinerary Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  city      City?           @relation(fields: [cityId], references: [id])
  items     ItineraryItem[]

  @@unique([itineraryId, dayIndex])
  @@map("itinerary_days")
}

model ItineraryItem {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayId             String       @map("day_id") @db.Uuid
  seq               Int          @db.SmallInt
  kind              ItinItemKind
  templeId          String?      @map("temple_id") @db.Uuid
  aartiScheduleId   String?      @map("aarti_schedule_id") @db.Uuid
  poiId             String?      @map("poi_id") @db.Uuid
  exploreItemId     String?      @map("explore_item_id") @db.Uuid
  title             String
  startsAt          DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?    @map("ends_at") @db.Timestamptz(3)
  travelDistanceM   Int?         @map("travel_distance_m")
  travelDurationMin Int?         @map("travel_duration_min")
  estCostPaise      Int?         @map("est_cost_paise")
  note              String?

  day           ItineraryDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  temple        Temple?        @relation(fields: [templeId], references: [id])
  aartiSchedule AartiSchedule? @relation(fields: [aartiScheduleId], references: [id])
  poi           Poi?           @relation(fields: [poiId], references: [id])
  exploreItem   ExploreItem?   @relation(fields: [exploreItemId], references: [id])

  @@unique([dayId, seq])
  @@map("itinerary_items")
}

model AiUsage {
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  requests     Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costMicros   BigInt   @default(0) @map("cost_micros")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("ai_usage")
}

