model NotificationTemplate {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                  String
  channel              NotifChannel
  titleI18n            Json?        @map("title_i18n")
  bodyI18n             Json         @map("body_i18n")
  dltTemplateId        String?      @map("dlt_template_id")
  whatsappTemplateName String?      @map("whatsapp_template_name")
  variables            String[]     @default([])
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  notifications Notification[]

  @@unique([key, channel])
  @@map("notification_templates")
}

model Notification {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?      @map("user_id") @db.Uuid
  templateId        String?      @map("template_id") @db.Uuid
  channel           NotifChannel
  recipient         String?
  title             String?
  body              String
  data              Json         @default("{}")
  status            NotifStatus  @default(queued)
  providerMessageId String?      @map("provider_message_id")
  error             String?
  scheduledFor      DateTime?    @map("scheduled_for") @db.Timestamptz(3)
  sentAt            DateTime?    @map("sent_at") @db.Timestamptz(3)
  readAt            DateTime?    @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, scheduledFor])
  @@map("notifications")
}

model SosEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  status         SosStatus @default(triggered)
  lat            Float
  lng            Float
  accuracyM      Int?      @map("accuracy_m")
  locationTrail  Json      @default("[]") @map("location_trail")
  batteryPct     Int?      @map("battery_pct") @db.SmallInt
  shareToken     String    @unique @map("share_token")
  shareExpiresAt DateTime  @map("share_expires_at") @db.Timestamptz(3)
  dispatchResult Json      @default("{}") @map("dispatch_result")
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  handledById    String?   @map("handled_by") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User  @relation("SosUser", fields: [userId], references: [id])
  handledBy User? @relation("SosHandler", fields: [handledById], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@map("sos_events")
}

/// Append-only. The production app role has no UPDATE/DELETE grant on this table.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model AppConfig {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String     @unique
  value       Json
  kind        ConfigKind
  targeting   Json       @default("{}")
  isActive    Boolean    @default(true) @map("is_active")
  startsAt    DateTime?  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?  @map("ends_at") @db.Timestamptz(3)
  updatedById String?    @map("updated_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("app_config")
}
