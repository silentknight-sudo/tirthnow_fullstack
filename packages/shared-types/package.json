{
  "name": "@tirth-now/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared enums, error codes, money helpers and Zod schemas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tirth-now/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
